<?xml version="1.0" encoding="utf-8"?>
<!--
    شريط تقدّم الوقت بين الصلاتين — مقابل ‎.hero-progress و‎.hero-progress-fill.
    المسار بشفافية 16% والتعبئة تدرّج من الذهبي إلى الأبيض، تماماً كما في التطبيق.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_white_16" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="left">
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="@color/widget_gold"
                    android:endColor="@color/widget_white"
                    android:type="linear" />
                <corners android:radius="100dp" />
            </shape>
        </clip>
    </item>
</layer-list>
