<?xml version="1.0" encoding="utf-8"?>
<!--
    ودجت العدّاد الصغير — الوقت المتبقي للصلاة القادمة ولا شيء غيره.

    نفس خلفية البطاقة ونفس اللون الذهبي للعدّاد، لكن بأصغر حجم ممكن (خانتان ×
    خانة واحدة). حجم الخط يُحسب من عرض الودجت الفعلي في PrayerWidgetRenderer.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg_hero">

    <Chronometer
        android:id="@+id/widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/widget_gold"
        android:textSize="20sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textDirection="ltr" />

    <!-- يحلّ محلّ العدّاد عند دخول وقت الصلاة -->
    <TextView
        android:id="@+id/widget_countdown_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center"
        android:text="@string/widget_time_now"
        android:textColor="@color/widget_gold"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/widget_no_data"
        android:textColor="@color/widget_white_90"
        android:textSize="10sp"
        android:visibility="gone" />
</FrameLayout>
