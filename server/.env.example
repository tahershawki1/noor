# ===== إعدادات باك اند نور =====
# انسخ هذا الملف إلى .env واملأ ما تحتاجه (كل القيم اختيارية عدا ما يُذكر)

# المنفذ والمضيف
PORT=8787
HOST=0.0.0.0

# مجلد تخزين ملفات الذاكرة (يُنشأ تلقائياً)
DATA_DIR=./data

# ===== مراقبة GitHub =====
GITHUB_REPO=tahershawki1/noor
GITHUB_BRANCH=main

# توكن GitHub (اختياري): يرفع حد الطلبات من 60 إلى 5000 طلب/ساعة
# أنشئه من: https://github.com/settings/tokens  (صلاحية public_repo تكفي)
GITHUB_TOKEN=

# سرّ الويب هوك — مطلوب لتفعيل /api/github/webhook (التحديث الفوري)
# اختر نصاً عشوائياً طويلاً وضعه أيضاً في إعدادات الويب هوك على GitHub
GITHUB_WEBHOOK_SECRET=

# كل كم مللي ثانية يسأل الخادم GitHub تلقائياً (0 = تعطيل)
GITHUB_POLL_INTERVAL_MS=120000
GITHUB_CACHE_TTL_MS=60000

# ===== الحماية =====
# أصول الويب المسموح لها (مفصولة بفواصل). اتركه فارغاً للسماح للجميع.
ALLOWED_ORIGINS=https://tahershawki1.github.io

# توكن اختياري لحماية واجهات الذاكرة (يُرسل في ترويسة x-noor-token)
API_TOKEN=

# ===== الحدود =====
MAX_ENTRIES_PER_DEVICE=5000
RATE_WINDOW_MS=60000
RATE_MAX=300

# نسخة التطبيق المعلنة
APP_VERSION=1.1.0
